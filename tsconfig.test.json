{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        /* Alsatian consumes compiled JS, so this config still emits. */
        "noEmit": false,
        "outDir": "bin-test",

        /* Alsatian's fixtures are decorator-based, which is not erasable syntax.
           Temporary: removed with alsatian when the suite moves to node:test. */
        "erasableSyntaxOnly": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "test/**/*"
    ]
}
