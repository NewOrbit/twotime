{
  "name": "@neworbit/twotime",
  "version": "3.1.1",
  "description": "Sync timesheets between Harvest and Targetprocess",
  "type": "module",
  "bin": {
    "twotime": "dist/twotime.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepublishOnly": "npm run build && npm run test && npm run lint",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/twotime.cjs",
    "build": "npm run typecheck && npm run bundle",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "lint": "eslint src/**/*.ts test/**/*.ts --max-warnings=0",
    "lint:fix": "eslint src/**/*.ts test/**/*.ts --max-warnings=0 --quiet --fix",
    "start": "node src/index.ts start",
    "auth": "node src/index.ts auth",
    "list": "node src/index.ts list",
    "finish": "node src/index.ts finish"
  },
  "files": [
    "dist"
  ],
  "author": "NewOrbit Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewOrbit/twotime.git"
  },
  "bugs": {
    "url": "https://github.com/NewOrbit/twotime/issues"
  },
  "homepage": "https://github.com/NewOrbit/twotime#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@types/configstore": "^6.0.2",
    "@types/inquirer": "7.3.3",
    "@types/inquirer-autocomplete-prompt": "^1.3.2",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "configstore": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.19.0",
    "eslint-config-neworbit": "^10.0.0",
    "globals": "^15.14.0",
    "inquirer": "^8.2.7",
    "inquirer-autocomplete-prompt": "^2.0.1",
    "table": "^6.9.0",
    "typescript": "^6.0.3",
    "vsts-npm-auth": "^0.43.0"
  }
}
