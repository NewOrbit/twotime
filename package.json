{
    "name": "@neworbit/twotime",
    "version": "4.0.0",
    "description": "Sync timesheets between Harvest and Targetprocess",
    "homepage": "https://github.com/NewOrbit/twotime#readme",
    "bugs": {
        "url": "https://github.com/NewOrbit/twotime/issues"
    },
    "license": "MIT",
    "author": "NewOrbit Ltd",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NewOrbit/twotime.git"
    },
    "bin": {
        "twotime": "dist/twotime.cjs"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "scripts": {
        "prepublishOnly": "pnpm run build && pnpm run test && pnpm run lint",
        "typecheck": "tsc --noEmit",
        "bundle": "rolldown src/index.ts -o dist/twotime.cjs --format cjs --platform node --transform.target node24",
        "build": "pnpm run typecheck && pnpm run bundle",
        "test": "node --test \"test/**/*.test.ts\"",
        "test:watch": "node --test --watch \"test/**/*.test.ts\"",
        "lint": "oxlint --deny-warnings && eslint src/**/*.ts test/**/*.ts scripts/**/*.ts --max-warnings=0",
        "lint:fix": "oxlint --deny-warnings --fix && eslint src/**/*.ts test/**/*.ts scripts/**/*.ts --max-warnings=0 --quiet --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "start": "node src/index.ts start",
        "auth": "node src/index.ts auth",
        "list": "node src/index.ts list",
        "finish": "node src/index.ts finish"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@inquirer/prompts": "^8.7.3",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "chalk": "^6.0.1",
        "commander": "^15.0.0",
        "configstore": "^8.0.0",
        "eslint": "^9.39.5",
        "eslint-config-neworbit": "^11.0.0",
        "eslint-plugin-oxlint": "^1.88.0",
        "globals": "^17.13.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "rolldown": "^1.2.14",
        "table": "^6.9.0",
        "typescript": "^6.0.3",
        "vsts-npm-auth": "^0.43.0"
    },
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    },
    "packageManager": "pnpm@12.14.0"
}
